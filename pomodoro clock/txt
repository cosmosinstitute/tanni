[24/10, 12:17 pm] The Unnamed Venom: let minutes = 25;
let seconds = 0;
let isRunning = false;
let historyList = [];

const minutesElement = document.getElementById("minutes");
const secondsElement = document.getElementById("seconds");
const startButton = document.getElementById("start");
const resetButton = document.getElementById("reset");
const historyListElement = document.getElementById("historyList");
const workLabelInput = document.getElementById("workLabel");

startButton.addEventListener("click", () => {
    if (!isRunning) {
        isRunning = true;
        startButton.textContent = "Stop";
        if (minutes === 0 && seconds === 0) {
            promptUserForDuration();
        } else {
            startTimer();
        }
    } else {
        isRunning = false;
        startButton.textContent = "Start";
        clearInterval(timerInterval);
    }
});

resetButton.addEventListener("click", () => {
    isRunning = false;
    startButton.textContent = "Start";
    minutes = 25;
    seconds = 0;
    updateClock();
    clearInterval(timerInterval);
    historyList = [];
    historyListElement.innerHTML = "";
    workLabelInput.value = "";
});

function promptUserForDuration() {
    const desiredMinutes = parseInt(prompt("Enter desired Pomodoro duration (in minutes):"));
    if (!isNaN(desiredMinutes)) {
        minutes = desiredMinutes;
        updateClock();
        startTimer();
    }
}

function startTimer() {
    timerInterval = setInterval(() => {
        if (seconds === 0) {
            minutes--;
            seconds = 59;
        } else {
            seconds--;
        }
        updateClock();

        if (minutes === 0 && seconds === 0) {
            clearInterval(timerInterval);
            isRunning = false;
            startButton.textContent = "Start";
            saveToHistory();
            alert("Pomodoro session completed!");
        }
    }, 1000);
}

function updateClock() {
    minutesElement.textContent = String(minutes).padStart(2, "0");
    secondsElement.textContent = String(seconds).padStart(2, "0");
}

function saveToHistory() {
    const now = new Date();
    const formattedTime = now.toLocaleTimeString();
    const formattedDate = now.toLocaleDateString();
    const workLabel = workLabelInput.value;
    const historyItem = <li>${formattedDate} ${formattedTime} - ${minutes} minutes - ${workLabel}</li>;
    historyListElement.insertAdjacentHTML("afterbegin", historyItem);
    historyList.push(historyItem);
}
