<!DOCTYPE html>
<html>
<head>
    <title>Unpausable Pomodoro Clock</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Unpausable Pomodoro Clock</h1>
        <div class="clock">
            <span id="minutes">25</span>:<span id="seconds">00</span>
        </div>
        <div class="buttons">
            <button id="start">Start</button>
            <button id="reset">Reset</button>
        </div>
        <div class="history">
            <h2>History</h2>
            <ul id="historyList"></ul>
        </div>
        <div class="work-label-input">
            <label for="workLabel">Work Label:</label>
            <input type="text" id="workLabel">
        </div>
    </div>
    <script src="script.js"></script>
</body>
</html>
